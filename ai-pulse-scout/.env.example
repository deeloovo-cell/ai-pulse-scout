# SMTP credentials for sending digest emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient override (defaults to config/email.yaml value)
DIGEST_TO=

# Set to 'true' to skip actual SMTP send (dry run)
DRY_RUN=false

# GLM key insight analysis
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=GLM-5.1
GLM_FETCH_FULL_POSTS=true

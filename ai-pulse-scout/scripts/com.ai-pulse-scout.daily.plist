<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-pulse-scout.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/publish-static-site.sh</string>
    </array>

    <!-- Fire every day at 07:00 host local time for static-site publishing -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Capture launchd-level stderr (publish-static-site.sh redirects its own output to data/logs/) -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/logs/launchd-stderr.log</string>
</dict>
</plist>
